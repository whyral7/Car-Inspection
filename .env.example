# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Phase 4). Model for photo analysis, e.g. claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Razorpay (Phase 6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RC lookup (Phase 2): mock | surepass | other
RC_PROVIDER=
RC_API_KEY=

# Public base URL, e.g. http://localhost:3000 or https://treadmark.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional, dev only: extra hostname allowed to load the dev server (e.g. a tunnel)
DEV_LAN_ORIGIN=
